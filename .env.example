# Database settings
DB_TYPE=sqlite
DATABASE_URL=pastey.db

# Authentication settings
# Generate a secure secret key of at least 32 characters for production
JWT_SECRET=pastey-dev-secret-key-minimum-32chars!
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=2592000

# Redis settings (optional, uncomment to enable cache & auth session storage in Redis)
# REDIS_URL=redis://localhost:6379
# Cache TTL in seconds for pastes/users cached in Redis (default 3600)
# REDIS_CACHE_TTL_SECONDS=3600
# Views are buffered in Redis and flushed to the DB in batches of this size
# to avoid one DB write per view on popular pastes (default 10)
# REDIS_VIEW_FLUSH_THRESHOLD=10
